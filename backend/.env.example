# =====================================================================
# PWA Backend – Environment Variables
# =====================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya

# Direktori publik tempat file upload PWA disimpan
# (folder yang di-serve langsung oleh web server)
UPLOAD_BASE_DIR=/var/www/pwa/backend

# Direktori publik server AYPSIS (Laravel)
# File upload AYPSIS (avatars, berita, pamflet, dll.) ada di sini
AYPSIS_PUBLIC_DIR=/var/www/aypsis/public

# URL publik server AYPSIS (tanpa trailing slash)
# Digunakan sebagai fallback ketika file gambar tidak ditemukan di UPLOAD_BASE_DIR
# Contoh: https://sistem.perusahaan.com
# Kosongkan jika server PWA dan AYPSIS berada di domain yang sama
AYPSIS_BASE_URL=
